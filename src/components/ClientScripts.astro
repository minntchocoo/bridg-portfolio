---
// All client-side behavior from the original index.html.
// Kept as `is:inline` so the global functions used by inline onclick
// handlers (openSkill, openGmail, filterItems) stay on window, and the
// CDN globals (AOS) loaded in BaseLayout remain available.
---

<!-- Animation Script -->
<script is:inline>
  AOS.init({
    offset: 120,
    delay: 0,
    duration: 800,
    easing: "ease",
    once: true,
    mirror: false,
  });
</script>

<!-- Image modal -->
<script is:inline>
  var modal = document.getElementById("globalModal");
  var modalImg = document.getElementById("globalModalImage");
  var captionText = document.getElementById("globalCaption");

  var images = document.querySelectorAll("img");
  images.forEach(function (img) {
    img.onclick = function () {
      modal.style.display = "block";
      modalImg.src = this.src;
      captionText.innerHTML = this.alt;
    };
  });

  var span = document.getElementsByClassName("close")[0];
  span.onclick = function () {
    modal.style.display = "none";
  };
</script>

<!-- Skills tabs + smooth scroll -->
<script is:inline>
  function openSkill(evt, skillName) {
    var i, tabPanel, tabLink;

    tabPanel = document.getElementsByClassName("tab-panel");
    for (i = 0; i < tabPanel.length; i++) {
      tabPanel[i].style.display = "none";
      tabPanel[i].classList.remove("active");
    }

    tabLink = document.getElementsByClassName("tab-link");
    for (i = 0; i < tabLink.length; i++) {
      tabLink[i].classList.remove("active");
    }

    if (skillName === "all") {
      for (i = 0; i < tabPanel.length; i++) {
        tabPanel[i].style.display = "block";
        tabPanel[i].classList.add("active");
      }
    } else {
      document.getElementById(skillName).style.display = "block";
      document.getElementById(skillName).classList.add("active");
    }
    evt.currentTarget.classList.add("active");
  }

  document.addEventListener("DOMContentLoaded", function () {
    document.querySelector(".tab-link.active").click();
  });

  document.querySelectorAll(".btn").forEach(function (anchor) {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      const targetElement = document.querySelector(this.getAttribute("href"));
      targetElement.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });
</script>

<!-- Hire-me Gmail compose -->
<script is:inline>
  function openGmail() {
    const email = "b.nicolettejose@gmail.com";
    const subject = "Invitation for Interview –Job Position";
    const body = `Dear Bridget,

        Thank you for your interest in the Virtual Assistant position at [Company Name]. After reviewing your background and skills, we are impressed with your qualifications and would like to move forward in the hiring process.

    We would like to schedule an interview with you to learn more about your experiences and discuss how you could contribute to our team.

    Interview Details (to be confirmed):

    Proposed Date/Time: [Insert Options]

    Format: [Zoom/Google Meet/Phone Call]

    Interviewer: [Name/Position]

    Please reply with your availability, and we will confirm the schedule. If you have any questions or require further information before the interview, feel free to reach out.

    We look forward to speaking with you.

    Best regards,
    [Your Name]
    [Company Name]
    [Contact Information]`;

    const mailtoLink = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(
      email
    )}&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    const confirmSend = confirm(
      `Are you sure you want to send this job offer email to ${email}?`
    );

    if (confirmSend) {
      window.open(mailtoLink, "_blank");
    }
  }
</script>

<!-- Certificate filter -->
<script is:inline>
  function filterItems(category) {
    var items = document.querySelectorAll(".gallery-item");

    items.forEach(function (item) {
      if (category === "all" || item.classList.contains(category)) {
        item.classList.remove("hidden");
        item.classList.add("show");
      } else {
        item.classList.remove("show");
        item.classList.add("hidden");
      }
    });

    AOS.refresh();
  }
</script>

<!-- Flower canvas animation -->
<script is:inline>
  const canvases = [
    { id: "flowerCanvas1", type: "flower" },
    { id: "flowerCanvas2", type: "flower" },
    { id: "flowerCanvas3", type: "flower" },
    { id: "flowerCanvas4", type: "flower" },
    { id: "flowerCanvas5", type: "flower" },
    { id: "flowerCanvas6", type: "flower" },
    { id: "flowerCanvas7", type: "flower" },
    { id: "flowerCanvas8", type: "flower" },
  ];

  const rows = 3;
  const cols = 3;
  const gridPositions = [];

  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      gridPositions.push({
        top: `${r * (100 / rows) + (Math.random() * 10 - 5)}%`,
        left: `${c * (100 / cols) + (Math.random() * 10 - 5)}%`,
      });
    }
  }

  gridPositions.sort(() => Math.random() - 0.5);

  canvases.forEach((canvasData, index) => {
    const canvas = document.getElementById(canvasData.id);
    const ctx = canvas.getContext("2d");
    let bloomProgress = 0;
    let direction = 1;

    canvas.width = 50;
    canvas.height = 50;

    canvas.style.top = gridPositions[index].top;
    canvas.style.left = gridPositions[index].left;

    function drawFlower(x, y, bloomSize) {
      const petalCount = 8;
      const petalRadius = bloomSize * 10;
      const centerRadius = bloomSize * 5;

      for (let i = 0; i < petalCount; i++) {
        const angle = ((Math.PI * 2) / petalCount) * i;
        const petalX = x + Math.cos(angle) * petalRadius;
        const petalY = y + Math.sin(angle) * petalRadius;

        ctx.beginPath();
        ctx.arc(petalX, petalY, petalRadius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 100, 100, ${1 - bloomSize})`;
        ctx.fill();
      }

      ctx.beginPath();
      ctx.arc(x, y, centerRadius, 0, Math.PI * 2);
      ctx.fillStyle = "yellow";
      ctx.fill();
    }

    function animate() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      bloomProgress += direction * 0.02;
      if (bloomProgress > 1) {
        bloomProgress = 1;
        direction = -1;
      } else if (bloomProgress < 0) {
        bloomProgress = 0;
        direction = 1;
      }

      drawFlower(canvas.width / 2, canvas.height / 2, bloomProgress);

      requestAnimationFrame(animate);
    }

    animate();
  });
</script>
