---
interface Props {
  title?: string;
}
const { title = "Minnt's Portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
      rel="stylesheet"
    />

    <!-- website icon -->
    <link rel="icon" type="image/x-icon" href="/assets/img/download.jpg" />

    <link rel="stylesheet" href="/assets/css/index.css" />
  </head>
  <body>
    <slot />

    <!-- Bootstrap JS and dependencies. Loaded synchronously (no defer) before
         the page's inline scripts so globals like AOS and $ are defined when
         <slot name="scripts" /> runs. -->
    <script
      is:inline
      src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"
    ></script>
    <script
      is:inline
      src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>

    <!-- Page inline scripts run after the CDN libraries above. -->
    <slot name="scripts" />
  </body>
</html>
